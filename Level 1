<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vocabulary Activity Game!</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: 'Comic Sans MS', 'Fredoka', cursive, sans-serif;
    }
    body {
      background: linear-gradient(135deg, #a8edd9 0%, #fed6e3 100%);
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .game-card {
      background: #ffffff;
      border-radius: 25px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
      width: 100%;
      max-width: 480px;
      padding: 25px;
      text-align: center;
      border: 5px solid #FFD166;
    }
    h1 {
      color: #EF476F;
      font-size: 26px;
      margin-bottom: 5px;
    }
    p.subtitle {
      color: #118AB2;
      font-weight: bold;
      margin-top: 0;
    }
    .input-group {
      margin: 20px 0;
      text-align: left;
    }
    label {
      display: block;
      margin-bottom: 5px;
      color: #073B4C;
      font-weight: bold;
    }
    input[type="text"] {
      width: 100%;
      padding: 12px;
      border: 3px solid #06D6A0;
      border-radius: 12px;
      font-size: 16px;
      outline: none;
    }
    .emoji-display {
      font-size: 80px;
      margin: 10px 0;
      animation: bounce 1.2s infinite alternate;
    }
    @keyframes bounce {
      from { transform: translateY(0); }
      to { transform: translateY(-12px); }
    }
    .question-text {
      font-size: 18px;
      color: #073B4C;
      margin-bottom: 15px;
      font-weight: bold;
    }
    .options-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .btn-option {
      background-color: #118AB2;
      color: white;
      border: none;
      padding: 14px 8px;
      border-radius: 15px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 4px #073B4C;
      transition: all 0.1s ease;
    }
    .btn-option:hover {
      background-color: #06D6A0;
    }
    .btn-option:active {
      box-shadow: 0 0 #073B4C;
      transform: translateY(4px);
    }
    .btn-main {
      background-color: #FFD166;
      color: #073B4C;
      border: none;
      padding: 14px 28px;
      font-size: 18px;
      font-weight: bold;
      border-radius: 20px;
      cursor: pointer;
      box-shadow: 0 5px #F78C6B;
      margin-top: 15px;
      width: 100%;
    }
    .btn-main:active {
      box-shadow: 0 0 #F78C6B;
      transform: translateY(5px);
    }
    .hidden {
      display: none;
    }
    .score-badge {
      font-size: 48px;
      color: #EF476F;
      font-weight: bold;
    }
  </style>
</head>
<body>

  <div class="game-card">
    <!-- Halaman Awal -->
    <div id="start-screen">
      <h1>🎮 Vocabulary Game 🎨</h1>
      <p class="subtitle">Ayo Belajar Activity Words!</p>
      
      <div class="input-group">
        <label for="student-name">Nama Siswa:</label>
        <input type="text" id="student-name" placeholder="Ketik namamu di sini..." required>
      </div>

      <button class="btn-main" onclick="startGame()">Mulai Main! 🚀</button>
    </div>

    <!-- Halaman Kuis -->
    <div id="quiz-screen" class="hidden">
      <div class="question-text" id="question-number">Soal 1/7</div>
      <div class="emoji-display" id="question-emoji">🏃</div>
      <div class="question-text" id="question-prompt">Kegiatan apakah ini?</div>
      
      <div class="options-grid" id="options-container"></div>
    </div>

    <!-- Halaman Hasil -->
    <div id="result-screen" class="hidden">
      <h1>🎉 Hebat Sekali! 🎉</h1>
      <p id="student-result-name" style="font-weight: bold; font-size: 20px;"></p>
      <p>Nilai Kamu:</p>
      <div class="score-badge" id="final-score">100</div>
      <p id="status-message" style="color: #118AB2; margin-top: 15px;"></p>
      <button class="btn-main" onclick="resetGame()">Main Lagi 🔄</button>
    </div>
  </div>

  <script>
    // 7 Vocabulary Activities (Dancing diganti Singing agar pas 7 unik)
    const quizData = [
      { word: "going", emoji: "🚶‍♂️", prompt: "Siswa sedang berjalan/pergi ke suatu tempat..." },
      { word: "writing", emoji: "✍️", prompt: "Siswa sedang menulis di buku..." },
      { word: "reading", emoji: "📖", prompt: "Siswa sedang membaca buku..." },
      { word: "dancing", emoji: "💃", prompt: "Siswa sedang menari..." },
      { word: "watching", emoji: "📺", prompt: "Siswa sedang menonton..." },
      { word: "having lunch", emoji: "🍱", prompt: "Siswa sedang makan siang..." },
      { word: "singing", emoji: "🎤", prompt: "Siswa sedang bernyanyi..." }
    ];

    let currentQuestionIndex = 0;
    let score = 0;
    let studentName = "";

    // MASUKKAN URL GOOGLE APPS SCRIPT ANDA DI SINI
    const GOOGLE_SCRIPT_URL = "ISI_URL_GOOGLE_SCRIPT_ANDA";

    function startGame() {
      const nameInput = document.getElementById("student-name").value;
      if (nameInput.trim() === "") {
        alert("Isi nama kamu dulu ya! 😊");
        return;
      }
      studentName = nameInput;
      currentQuestionIndex = 0;
      score = 0;

      document.getElementById("start-screen").classList.add("hidden");
      document.getElementById("quiz-screen").classList.remove("hidden");
      loadQuestion();
    }

    function loadQuestion() {
      const q = quizData[currentQuestionIndex];
      document.getElementById("question-number").innerText = `Soal ${currentQuestionIndex + 1} dari ${quizData.length}`;
      document.getElementById("question-emoji").innerText = q.emoji;
      document.getElementById("question-prompt").innerText = q.prompt;

      const container = document.getElementById("options-container");
      container.innerHTML = "";

      let options = [q.word];
      while (options.length < 4) {
        let randomWord = quizData[Math.floor(Math.random() * quizData.length)].word;
        if (!options.includes(randomWord)) {
          options.push(randomWord);
        }
      }
      options.sort(() => Math.random() - 0.5);

      options.forEach(opt => {
        const btn = document.createElement("button");
        btn.className = "btn-option";
        btn.innerText = opt;
        btn.onclick = () => selectAnswer(opt, q.word);
        container.appendChild(btn);
      });
    }

    function selectAnswer(selected, correct) {
      if (selected === correct) {
        score += Math.round(100 / quizData.length);
      }

      currentQuestionIndex++;
      if (currentQuestionIndex < quizData.length) {
        loadQuestion();
      } else {
        finishGame();
      }
    }

    function finishGame() {
      if (score > 100) score = 100;

      document.getElementById("quiz-screen").classList.add("hidden");
      document.getElementById("result-screen").classList.remove("hidden");
      
      document.getElementById("student-result-name").innerText = `Terima kasih, ${studentName}!`;
      document.getElementById("final-score").innerText = score;

      sendDataToExcel(studentName, score);
    }

    function sendDataToExcel(name, finalScore) {
      if (!GOOGLE_SCRIPT_URL || GOOGLE_SCRIPT_URL === "ISI_URL_GOOGLE_SCRIPT_ANDA") {
        document.getElementById("status-message").innerText = "Permainan selesai! (Nilai belum terhubung ke Google Sheets)";
        return;
      }

      document.getElementById("status-message").innerText = "Menyimpan nilai...";

      const formData = new FormData();
      formData.append("nama", name);
      formData.append("nilai", finalScore);

      fetch(GOOGLE_SCRIPT_URL, {
        method: "POST",
        body: formData
      })
      .then(() => {
        document.getElementById("status-message").innerText = "✨ Nilai kamu berhasil tersimpan di Rekap Bu Desti! ✨";
      })
      .catch(() => {
        document.getElementById("status-message").innerText = "Gagal mengirim data ke server.";
      });
    }

    function resetGame() {
      document.getElementById("student-name").value = "";
      document.getElementById("result-screen").classList.add("hidden");
      document.getElementById("start-screen").classList.remove("hidden");
    }
  </script>
</body>
</html>
